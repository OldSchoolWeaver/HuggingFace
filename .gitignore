.env

# virtual environments (each app has its own; never commit them)
.venv/
__pycache__/
.DS_Store
# local agent data: checkpointer databases (memory.db = saved conversations)
*.db

# generated by the agents at run time
# Playwright MCP console logs and page snapshots
.playwright-mcp/
# agent working folders (sidekick_agent/sandbox, engineering_team_agent/sandbox)
sandbox/

# semantic_layer_agent: Cube Store data and local eval results
semantic_layer_agent/cube/.cubestore/
semantic_layer_agent/evals/results/

# agentic_frameworks: SQLite run state (e.g. the google_sdk todo board and its WAL files)
*.sqlite
*.sqlite-shm
*.sqlite-wal
