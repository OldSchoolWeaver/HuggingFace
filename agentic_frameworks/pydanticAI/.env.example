# Nothing is required here: the model settings come from the repo-root .env, which worker.py loads:
#   OPENAI_BASE_URL=http://localhost:4000   the LiteLLM gateway
#   OPENAI_API_KEY=sk-...                    a LiteLLM key

# Optional
# WORKER_MODEL=gpt-5.4-mini                 the model, by the name your gateway knows it (default gpt-5.4-mini)
# BOARD_PATH=/path/to/board.sqlite          where the todo board lives (default: board.sqlite in this folder)
# PYDANTIC_AI_NO_BANNER=1                   hide Pydantic AI's "observability: off" banner
