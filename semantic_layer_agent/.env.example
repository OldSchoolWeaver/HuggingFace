# Copy to .env (git-ignored) and change the passwords. The agent also reads the repo-root .env for
# OPENAI_API_KEY / OPENAI_BASE_URL (your LiteLLM gateway).

# Postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=admin
ANALYST_PASSWORD=analyst                  # read-only role: agent, MCP servers, Cube, DuckDB
CATALOG_READER_PASSWORD=catalog           # DataHub ingestion
AGENT_DB_PASSWORD=agent                   # agent_app: owns the agent_state database (saved conversations)

# Cube semantic layer (4000 is taken by LiteLLM)
CUBE_PORT=4001
CUBE_SQL_PORT=15432
CUBEJS_API_SECRET=local-dev-cube-secret-change-me-0123456789
CUBEJS_SQL_PASSWORD=cube

# MCP servers running in Docker
DUCKDB_MCP_PORT=8001
POSTGRES_MCP_PORT=8002

# DataHub (included in docker/docker-compose.yml from its official quickstart file)
COMPOSE_PROFILES=quickstart              # starts DataHub's services together with the others
DATAHUB_VERSION=v1.7.0
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0.20
# DATAHUB_TOKEN_SERVICE_SIGNING_KEY / DATAHUB_TOKEN_SERVICE_SALT are generated by scripts/setup.sh
DATAHUB_MAPPED_GMS_PORT=58080             # host port for DataHub's API: change it (e.g. 58080) if 8080 is taken
DATAHUB_MAPPED_FRONTEND_PORT=9002        # host port for DataHub's UI
DATAHUB_GMS_URL=http://localhost:58080    # must use DATAHUB_MAPPED_GMS_PORT
DATAHUB_GMS_TOKEN=                        # only needed if you turn on metadata service authentication

# Agent
AGENT_MODEL=gpt-5.4-mini                      # must be a model name your LiteLLM gateway (or OpenAI) knows
ROUTER_MODEL=gpt-4o-mini                      # small model that picks the starting layer (cube / datahub / direct)
JUDGE_MODEL=gpt-4o-mini                       # grades answers in `evals/run_evals.py --judge`
FALLBACK_MODEL=                               # optional: used when AGENT_MODEL keeps failing (e.g. gpt-4.1)
CHECKPOINTER=postgres                         # where conversations are saved: postgres (agent_state db) or memory
# AGENT_STATE_DB_URL=postgresql://agent_app:agent@localhost:5432/agent_state   # default is built from the above

# Tracing: LangSmith settings live in the repo-root .env (LANGSMITH_TRACING, LANGSMITH_API_KEY, LANGSMITH_ENDPOINT and
# the destination). Set exactly ONE destination: an agent address (LANGSMITH_AGENT_ID + LANGSMITH_AGENT_ENVIRONMENT)
# or a project (LANGSMITH_PROJECT). With both set, LangSmith refuses to trace (EnvAddressError).
